{
  "name": "before-you-paste",
  "version": "1.0.0",
  "description": "On-device check for personal and sensitive details before pasting into generative AI tools",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-coverage-include=web/js/core/** --test-coverage-lines=85 test/*.test.js",
    "lint": "eslint .",
    "check:site": "node scripts/check_site.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:model": "node scripts/eval.mjs --with-model",
    "test:browser": "node --test --test-reporter=spec --test-reporter-destination=stdout test/browser.test.mjs",
    "test:model": "RUN_MODEL_TESTS=1 node --test --test-reporter=spec --test-reporter-destination=stdout test/browser.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@huggingface/transformers": "4.3.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
